<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.JarvisAI" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/jarvis_cyan</item>
        <item name="colorPrimaryVariant">@color/jarvis_dark_cyan</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:windowBackground">@color/jarvis_bg</item>
    </style>

    <style name="Theme.JarvisAI.NoActionBar" parent="Theme.JarvisAI">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>